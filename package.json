{
	"name": "gitignore-to-glob-cli",
	"version": "0.2.0",
	"description": "Converts gitignore patterns into minimatch-style globs.",
	"license": "MIT",
	"repository": "tommy-mitchell/gitignore-to-glob-cli",
	"author": "Tommy Mitchell (https://tommymitchell.io)",
	"type": "module",
	"bin": {
		"gitignore-to-glob": "./dist/cli.js"
	},
	"engines": {
		"node": "^22.22 || ^24.15 || >=26"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "tsc -p tsconfig.build.json && execify --pkg",
		"lint": "run-all 'dprint check' xo",
		"format": "dprint fmt && xo --fix",
		"test": "c8 ava && tsc --noEmit"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"cli",
		"cli-app",
		"command-line",
		"gitignore",
		"minimatch",
		"glob"
	],
	"dependencies": {
		"@humanwhocodes/gitignore-to-minimatch": "^1.0.2",
		"find-up-simple": "^1.0.1",
		"log-symbols": "^7.0.1",
		"meow": "^14.1.0"
	},
	"devDependencies": {
		"@tommy-mitchell/configs": "^0.3.0",
		"@tommy-mitchell/test-helpers": "^0.1.1",
		"@types/node": "^22.20",
		"ava": "^8.0.2",
		"c8": "^12.0.0",
		"dprint": "^0.63.0",
		"execify-cli": "^1.0.0",
		"run-all-cli": "^0.1.0",
		"type-fest": "^5.10.0",
		"typescript": "~6.0.3",
		"xo": "^5.0.1"
	},
	"ava": {
		"extensions": [
			"ts"
		],
		"environmentVariables": {
			"concurrency": "5"
		}
	}
}
